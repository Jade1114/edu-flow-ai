# Server

SERVER_PORT=8080

# MySQL

DB_URL=jdbc:mysql://localhost:3306/edu_flow_ai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=
DB_PASSWORD=

# Chat / Generate Model - OpenAI compatible

OPENAI_CHAT_API_KEY=
OPENAI_CHAT_BASE_URL=https://api.deepseek.com
OPENAI_CHAT_MODEL=deepseek-v4-flash

# Python ML logging: DEBUG / INFO / WARNING / ERROR

ML_LOG_LEVEL=INFO

# GA generation profile: fast / default / quality

ML_GA_PROFILE=fast