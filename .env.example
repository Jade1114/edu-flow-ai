# Server

SERVER_PORT=8080

# MySQL

DB_URL=jdbc:mysql://localhost:3306/edu_flow_ai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=
DB_PASSWORD=

# Chat / Generate Model - OpenAI compatible

OPENAI_CHAT_API_KEY=
OPENAI_CHAT_BASE_URL=https://api.deepseek.com
OPENAI_CHAT_MODEL=deepseek-v4-flash

# Python ML logging: DEBUG / INFO / WARNING / ERROR

ML_LOG_LEVEL=INFO

# ML model paths (defaults: ml/models/base/ and ml/models/feedback/current/)
#
# ML_BASE_MODEL_PATH=ml/models/base/schedule_ranker_v1.txt
# ML_BASE_FEATURE_SCHEMA_PATH=ml/models/base/feature_schema.json
# ML_FEEDBACK_MODEL_PATH=ml/models/feedback/current/schedule_ranker.txt
# ML_FEEDBACK_FEATURE_SCHEMA_PATH=ml/models/feedback/current/feature_schema.json

# GA generation profile: fast / default / quality

ML_GA_PROFILE=fast
# Leave unset to use the selected profile default. Avoid 16 for full-size scheduling.
# ML_GA_CANDIDATE_TOP_N=40

# Candidate-pool workers. Leave unset for auto: min(cpu_count - 1, 6).
# Set to 1 to force serial candidate construction when debugging.
# ML_CANDIDATE_WORKERS=6

# GA repair budget. Keep small for full-size scheduling; repair is expensive.
# ML_GA_REPAIR_MAX_TASKS=2
# ML_GA_REPAIR_CANDIDATE_LIMIT=12

# GA global greedy initialization and directed mutation scan budgets.
# ML_GA_GREEDY_INIT_SCAN_LIMIT=8
# ML_GA_GREEDY_INIT_VARIANTS=2
# ML_GA_DIRECTED_MUTATION_SCAN_LIMIT=0

# Candidate local expansion before GA. Keeps GA deterministic while improving local room/slot alternatives.
# ML_CANDIDATE_LOCAL_EXPAND_ENABLED=true
# ML_CANDIDATE_LOCAL_EXPAND_SLOT_LIMIT=12
# ML_CANDIDATE_LOCAL_EXPAND_ROOM_LIMIT=12
# ML_CANDIDATE_LOCAL_EXPAND_MAX_ADDED_PER_TASK=80

# GA local resource replacement. Teacher/class conflicts prefer slot replacement; room conflicts prefer room replacement.
# ML_GA_LOCAL_REPAIR_ENABLED=true
# ML_GA_LOCAL_REPAIR_CANDIDATE_LIMIT=12
# ML_GA_LOCAL_MUTATION_ENABLED=true
# ML_GA_LOCAL_MUTATION_CANDIDATE_LIMIT=8
