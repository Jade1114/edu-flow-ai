<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 标准输出：只到 INFO，格式简洁 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ===== 业务代码 ===== -->
    <!-- 核心业务：INFO -->
    <logger name="com.yuy.eduflow.allocation" level="INFO"/>
    <logger name="com.yuy.eduflow.teacher" level="INFO"/>
    <logger name="com.yuy.eduflow.rag" level="INFO"/>
    <logger name="com.yuy.eduflow.assignment" level="INFO"/>

    <!-- ML 训练/反馈模块：DEBUG（训练细节），可通过 Spring profile 覆盖 -->
    <logger name="com.yuy.eduflow.ml" level="DEBUG"/>

    <!-- ===== 框架 & 噪音源 ===== -->
    <!-- MyBatis：WARN（屏蔽 SQL 语句和参数） -->
    <logger name="org.mybatis" level="WARN"/>
    <logger name="org.mybatis.spring" level="WARN"/>
    <logger name="org.apache.ibatis" level="WARN"/>
    <!-- JDBC SQL 日志：WARN -->
    <logger name="java.sql" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <!-- Spring：WARN，启动时不刷 auto-config -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.boot" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
