{
  "type": "object",
  "required": ["schemes"],
  "additionalProperties": false,
  "properties": {
    "schemes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schemeName", "summary", "satisfiedSummary", "items"],
        "additionalProperties": false,
        "properties": {
          "schemeName": { "type": "string" },
          "summary": { "type": "string" },
          "satisfiedSummary": { "type": "string" },
          "items": {
            "type": "array",
            "description": "每个排课片段为 [teachingTaskId, timeSlotId]",
            "items": {
              "type": "array",
              "prefixItems": [
                { "type": "integer", "description": "teachingTaskId" },
                { "type": "integer", "description": "timeSlotId" }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  }
}
