# Server
SERVER_PORT=8080

# MySQL
DB_URL=jdbc:mysql://localhost:3306/edu_flow_ai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=

# ML API
ML_API_URL=http://127.0.0.1:8000
ML_DIR=

# Python ML logging: DEBUG / INFO / WARNING / ERROR
ML_LOG_LEVEL=INFO
# Optional per-logger overrides
ML_SERVICE_LOG_LEVEL=
ML_GA_LOG_LEVEL=
ML_TRAINING_LOG_LEVEL=
ML_SCORING_LOG_LEVEL=

# GA generation profile: fast / default / quality
ML_GA_PROFILE=default
# Optional overrides; leave empty to use the selected profile
ML_GA_CANDIDATE_POOL_SIZE=
ML_GA_CANDIDATE_TOP_N=
ML_GA_POPULATION_SIZE=
ML_GA_GENERATIONS=
ML_GA_ELITE_SIZE=
ML_GA_TOURNAMENT_SIZE=
ML_GA_MUTATION_RATE=

# Chat / Generate Model - OpenAI compatible
OPENAI_CHAT_API_KEY=
OPENAI_CHAT_BASE_URL=
OPENAI_CHAT_MODEL=
